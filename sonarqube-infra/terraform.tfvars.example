# AWS Configuration
aws_region = "us-east-1"

# EC2 Configuration
instance_type = "t3.medium"  # Minimum for SonarQube (2 vCPUs, 4GB RAM)
key_name      = "your-ec2-key-pair-name"

# Security Configuration
allowed_ssh_cidr = ["0.0.0.0/0"]  # Restrict this to your IP for better security
allowed_web_cidr = ["0.0.0.0/0"]  # Restrict this to your IP for better security

# Storage Configuration
root_volume_size = 30

# SonarQube Database Password
sonarqube_db_password = "StrongPasswordHere123!"
